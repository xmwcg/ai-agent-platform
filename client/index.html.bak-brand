<!doctype html>
<html lang="zh-CN">
  <head>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AIbak · 打造您的全栈 AI 应用平台</title>
    <meta name="description" content="AIbak：全栈 AI 应用平台。覆盖 AI 对话、知识中枢、智能工具箱、智评通项目质量评估、技能市场、MCP 插件与 Agent 工作流。专业版 ¥9.9/月起，支持多模型接入与开放 API 变现。" />
    <meta name="keywords" content="AI Agent, 智能体平台, AI 对话, RAG 知识库, MCP, 工作流, 技能市场, 大模型, 开放API, AIbak" />
    <meta name="author" content="AIbak" />
    <meta name="robots" content="index, follow" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AIbak · 打造您的全栈 AI 应用平台" />
    <meta property="og:description" content="AIbak 全栈 AI 平台：AI 对话 · 知识库 · 智能工具 · 智评通项目评估 · 技能市场。专业版 ¥9.9/月起。" />
    <meta property="og:url" content="https://aibak.site/" />
    <meta property="og:site_name" content="AIbak" />
    <meta property="og:image" content="https://aibak.site/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AIbak · 打造您的全栈 AI 应用平台" />
    <meta name="twitter:description" content="AIbak 全栈 AI 平台：AI 对话 · 知识库 · 智能工具 · 智评通项目评估 · 技能市场。专业版 ¥9.9/月起。" />
    <meta name="twitter:image" content="https://aibak.site/og-image.svg" />
    <!-- 结构化数据：站点搜索 + 软件应用，获得百度/Google 富结果 -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AIbak",
      "url": "https://aibak.site/",
      "description": "打造您的全栈 AI 应用平台：AI 对话、通用知识库、智能工具箱、技能市场、MCP 插件与 Agent 工作流。",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://aibak.site/knowledge?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "AIbak",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": "https://aibak.site/",
      "description": "商业级智能体平台：覆盖 AI 对话、RAG 知识库、MCP、技能市场与 Agent 工作流，支持多模型接入与开放 API 变现。",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      }
    }
    </script>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
