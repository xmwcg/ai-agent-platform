# syntax=docker/dockerfile:1.7
# CloudBase 云托管专用构建：前端静态 + nginx，/api 反代目标由环境变量 API_UPSTREAM 注入。
# 与原有 Dockerfile 并存，互不影响；云托管 client 服务改用此 Dockerfile（构建上下文 client/，Dockerfile 路径指向本文件）。
FROM node:22-bookworm-slim AS build

# 增大 Node 堆内存，避免 vite 在生产机构建时 OOM
ENV NODE_OPTIONS=--max-old-space-size=2048

WORKDIR /usr/src/app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig*.json vite.config.* index.html ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM nginx:1.30.0-alpine3.23 AS runtime

# envsubst 来自 gettext，用于把 API_UPSTREAM 渲染进 nginx 配置
RUN apk upgrade --no-cache && apk add --no-cache gettext

ARG APP_COMMIT_SHA=unknown
LABEL org.opencontainers.image.title="AIbak Web" \
      org.opencontainers.image.revision="$APP_COMMIT_SHA"

# API_UPSTREAM 默认值（docker-compose 直接跑此镜像时可用）；云托管部署时覆盖为 server 访问地址
ENV API_UPSTREAM=ai-platform-server

COPY --from=build /usr/src/app/dist /usr/share/nginx/html
# 模板放 templates，启动时由 envsubst 渲染为 default.conf
COPY nginx.cloudbase.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["/bin/sh", "-c", "envsubst '$API_UPSTREAM' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
